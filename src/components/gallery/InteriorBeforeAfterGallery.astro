---
import SectionIntro from '../shared/SectionIntro.astro';

const imageRoot = '/images/projects';
const projects = [
  {
    title: 'Kitchen Cabinet Painting Makeover in Avon, CT',
    before: 'cabinets-before',
    after: 'cabinets-after',
    beforeWidth: 1280,
    beforeHeight: 960,
    afterWidth: 1280,
    afterHeight: 960,
  },
  {
    title: 'Built-In Bookcase and Millwork Painting in Avon, CT',
    before: 'bookcase-before',
    after: 'bookcase-after',
    beforeWidth: 1280,
    beforeHeight: 960,
    afterWidth: 1280,
    afterHeight: 960,
  },
  {
    title: 'Bathroom Painting and Color Makeover in Avon, CT',
    before: 'bathroom-before',
    after: 'bathroom-after',
    beforeWidth: 1280,
    beforeHeight: 960,
    afterWidth: 1280,
    afterHeight: 1706,
  },
] as const;

const imageProps = (name: string, width: number, height: number) => ({
  src: `${imageRoot}/${name}.webp`,
  srcset: `${imageRoot}/${name}-640.webp 640w, ${imageRoot}/${name}-960.webp 960w, ${imageRoot}/${name}.webp 1280w`,
  width,
  height,
});
---
<section class="section-space bg-white" id="interior-before-and-after">
  <div class="site-container">
    <SectionIntro
      eyebrow="Interior before & after"
      title="Interior painting transformations, room by room."
      text="Explore cabinet, millwork, and bathroom painting projects completed in Avon, CT, then drag each comparison to see how careful preparation and finish work renewed each space."
    />

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      {projects.map((project, index) => {
        const before = imageProps(project.before, project.beforeWidth, project.beforeHeight);
        const after = imageProps(project.after, project.afterWidth, project.afterHeight);
        const rangeId = `interior-project-comparison-${index + 1}`;

        return (
          <article data-reveal>
            <div class="comparison" data-comparison>
              <div class="comparison__image comparison__image--after">
                <img {...after} sizes="(min-width: 1024px) 50vw, 100vw" alt={`After: ${project.title}`} loading="lazy" decoding="async" />
              </div>
              <div class="comparison__image comparison__image--before" data-before>
                <img {...before} sizes="(min-width: 1024px) 50vw, 100vw" alt={`Before: ${project.title}`} loading="lazy" decoding="async" />
              </div>
              <div class="comparison__divider" data-divider aria-hidden="true"><span>↔</span></div>
              <label class="sr-only" for={rangeId}>Compare before and after photos of {project.title}</label>
              <input id={rangeId} data-range class="comparison__range" type="range" min="0" max="100" value="48" />
              <span class="comparison__label comparison__label--before">Before</span>
              <span class="comparison__label comparison__label--after">After</span>
            </div>
            <h3 class="mt-5 text-2xl">{project.title}</h3>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  const initializeInteriorBeforeAfterGallery = () => {
    document.querySelectorAll<HTMLElement>('[data-comparison]').forEach((comparison) => {
      if (comparison.dataset.initialized === 'true') return;
      comparison.dataset.initialized = 'true';
      const range = comparison.querySelector<HTMLInputElement>('[data-range]');
      const before = comparison.querySelector<HTMLElement>('[data-before]');
      const divider = comparison.querySelector<HTMLElement>('[data-divider]');
      const update = () => {
        const value = range?.value ?? '50';
        if (before) before.style.clipPath = `inset(0 ${100 - Number(value)}% 0 0)`;
        if (divider) divider.style.left = `${value}%`;
      };
      range?.addEventListener('input', update);
      update();
    });
  };

  document.addEventListener('astro:page-load', initializeInteriorBeforeAfterGallery);
  initializeInteriorBeforeAfterGallery();
</script>
