---
import { site } from '../data/site';

const navItems: ReadonlyArray<readonly [label: string, href: string]> = [
  ['Home', '/'],
  ['Services', '/services'],
  ['Gallery', '/gallery'],
  ['About', '/about'],
  ['Reviews', '/reviews'],
  ['Contact', '/contact'],
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="sticky top-0 z-50 border-b border-navy-900/10 bg-warm-50/95 backdrop-blur-xl" data-site-header>
  <div class="site-container flex min-h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
      <span class="grid size-11 place-items-center rounded-full bg-navy-800 font-display text-xl font-bold text-white" aria-hidden="true">R</span>
      <span class="leading-tight">
        <strong class="block font-display text-lg text-navy-950">Rick's Colonial</strong>
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-gold-500">Painting</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary navigation">
      {navItems.map(([label, href]) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'text-sm font-bold transition-colors hover:text-gold-500 focus-visible:text-gold-500',
            isActive(href) ? 'text-gold-500' : 'text-navy-900',
          ]}
        >{label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a class="text-sm font-extrabold text-navy-900" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
      <a class="button-primary" href="/contact">Free Estimate</a>
    </div>

    <button class="menu-toggle grid size-11 place-items-center rounded-lg border border-navy-900/15 text-navy-900 lg:hidden" aria-controls="mobile-menu" aria-expanded="false" type="button">
      <span class="sr-only">Open navigation</span>
      <span aria-hidden="true">☰</span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-navy-900/10 bg-warm-50 lg:hidden">
    <nav class="site-container grid gap-1 py-4" aria-label="Mobile navigation">
      {navItems.map(([label, href]) => (
        <a href={href} aria-current={isActive(href) ? 'page' : undefined} class="rounded-lg px-4 py-3 font-bold text-navy-900 hover:bg-sand-100">{label}</a>
      ))}
      <a href="/contact" class="button-primary mt-3">Free Estimate</a>
    </nav>
  </div>
</header>

<script>
  const initializeHeader = () => {
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.querySelector<HTMLElement>('#mobile-menu');
    if (!toggle || !menu || toggle.dataset.initialized === 'true') return;

    toggle.dataset.initialized = 'true';
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.querySelector('.sr-only')!.textContent = 'Open navigation';
      menu.classList.add('hidden');
    };

    toggle.addEventListener('click', () => {
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(willOpen));
      toggle.querySelector('.sr-only')!.textContent = willOpen ? 'Close navigation' : 'Open navigation';
      menu.classList.toggle('hidden', !willOpen);
    });

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) closeMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  };

  document.addEventListener('astro:page-load', initializeHeader);
  initializeHeader();
</script>
