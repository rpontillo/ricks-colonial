---
interface Props {
  compact?: boolean;
  inverse?: boolean;
}

const { compact = false, inverse = false } = Astro.props;
---
<a href="/" class="group inline-flex items-center gap-3" aria-label="Rick's Colonial Painting home">
  <span class:list={["grid shrink-0 place-items-center rounded-full border", compact ? "size-10" : "size-12", inverse ? "border-white/35 text-white" : "border-gold/50 text-navy"]}>
    <svg viewBox="0 0 48 48" class="size-7" aria-hidden="true">
      <path d="M8 23.5 24 10l16 13.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M13 21.5V39h22V21.5M20 39V28h8v11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
      <path d="M17 24h4m6 0h4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    </svg>
  </span>
  <span class="leading-none">
    <span class:list={["block font-display text-xl font-semibold tracking-tight sm:text-2xl", inverse ? "text-white" : "text-navy-deep"]}>Rick's Colonial</span>
    <span class:list={["mt-1 block text-[0.63rem] font-bold uppercase tracking-[0.24em]", inverse ? "text-white/65" : "text-gold"]}>Painting & Restoration</span>
  </span>
</a>
