---
import { site } from '../data/site';
---
<footer class="relative overflow-hidden bg-navy-950 text-white">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400/60 to-transparent"></div>
  <div class="site-container grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-display text-3xl">{site.name}</p>
      <p class="mt-4 max-w-md leading-7 text-white/70">Professional interior and exterior painting rooted in careful preparation, lasting finishes, and respect for your home.</p>
    </div>
    <div>
      <h2 class="font-sans text-sm font-black uppercase tracking-[0.18em] text-gold-400">Explore</h2>
      <ul class="mt-4 space-y-3 text-white/75">
        <li><a class="hover:text-white" href="/services">Services</a></li>
        <li><a class="hover:text-white" href="/gallery">Gallery</a></li>
        <li><a class="hover:text-white" href="/about">About</a></li>
        <li><a class="hover:text-white" href="/contact">Free Estimate</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-sm font-black uppercase tracking-[0.18em] text-gold-400">Contact</h2>
      <address class="mt-4 space-y-3 not-italic text-white/75">
        <p>{site.region}</p>
        <p><a class="hover:text-white" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></p>
        <p><a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a></p>
      </address>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="site-container flex flex-col gap-2 py-6 text-sm text-white/55 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <p>Serving Connecticut homeowners with care.</p>
    </div>
  </div>
</footer>
