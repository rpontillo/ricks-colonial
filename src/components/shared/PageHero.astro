---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  image?: string;
}
const { eyebrow, title, intro, image } = Astro.props;
---
<section class:list={['relative isolate overflow-hidden bg-navy-950 text-white', image ? 'min-h-[34rem]' : '']}>
  {image && <img src={image} alt="" class="absolute inset-0 -z-20 size-full object-cover [filter:saturate(.78)_contrast(1.05)]" fetchpriority="high" />}
  {image && <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(16,35,56,.96)_0%,rgba(16,35,56,.82)_52%,rgba(16,35,56,.32)_100%)]"></div>}
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-400/60 to-transparent"></div>
  <div class="site-container flex min-h-[34rem] items-end py-20 sm:py-24 lg:py-28">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow text-gold-400">{eyebrow}</p>
      <h1 class="mt-5 text-[clamp(3.2rem,7vw,6.5rem)] leading-[.95] text-white">{title}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-white/78 sm:text-xl">{intro}</p>
    </div>
  </div>
</section>
