---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  image?: string;
}
const { eyebrow, title, intro, image } = Astro.props;
const imageSrcSet = image?.endsWith('.webp')
  ? `${image.replace('.webp', '-320.webp')} 320w, ${image.replace('.webp', '-480.webp')} 480w, ${image.replace('.webp', '-640.webp')} 640w, ${image.replace('.webp', '-800.webp')} 800w, ${image.replace('.webp', '-960.webp')} 960w, ${image} 1280w`
  : undefined;
---
<section class:list={['relative isolate overflow-hidden bg-navy-950 text-white', image ? 'min-h-136' : '']}>
  {image && <img src={image} srcset={imageSrcSet} sizes="100vw" alt="" width="1280" height="960" class="absolute inset-0 -z-20 size-full object-cover saturate-[0.78] contrast-[1.05]" fetchpriority="high" />}
  {image && <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(16,35,56,0.96)_0%,rgba(16,35,56,0.82)_52%,rgba(16,35,56,0.32)_100%)]"></div>}
  <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-gold-400/60 to-transparent"></div>
  <div class="site-container flex min-h-136 items-end py-20 sm:py-24 lg:py-28">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow text-gold-400 text-over-image">{eyebrow}</p>
      <h1 class="mt-5 text-[clamp(2.5rem,13vw,6.5rem)] leading-[0.95] text-white">{title}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-white/78 sm:text-xl">{intro}</p>
    </div>
  </div>
</section>
