---
import { services } from '../../data/home';
---
<section id="services" class="section-space bg-warm-50">
  <div class="site-container">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Our services</p>
      <h2 class="section-title mt-4">Thoughtful preparation. Beautiful, lasting finishes.</h2>
      <p class="section-copy mt-6">From a single room to a full exterior, every project receives the same careful planning, clear communication, and respect for your property.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {services.slice(0, 2).map((service) => (
        <article class="service-card group relative min-h-[31rem] overflow-hidden rounded-[1.5rem] bg-navy-950 shadow-soft" data-reveal>
          <img src={service.image} alt="" class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_25%,rgba(20,39,61,.92)_100%)]"></div>
          <div class="absolute inset-x-0 bottom-0 p-7 text-white sm:p-9">
            <h3 class="text-3xl text-white sm:text-4xl">{service.title}</h3>
            <p class="mt-3 max-w-xl leading-7 text-white/75">{service.description}</p>
            <a href={service.href} class="mt-6 inline-flex items-center gap-2 font-extrabold text-gold-400">Explore service <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-6 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {services.slice(2).map((service) => (
        <article class="group overflow-hidden rounded-card border border-navy-900/10 bg-white shadow-soft" data-reveal>
          <div class="aspect-[4/3] overflow-hidden">
            <img src={service.image} alt="" class="size-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
          </div>
          <div class="p-6">
            <h3 class="text-2xl">{service.title}</h3>
            <p class="mt-3 text-sm leading-6">{service.description}</p>
            <a href={service.href} class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-navy-800">Learn more <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
