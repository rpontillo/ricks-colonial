---
import { testimonials } from '../../data/home';
---
<section class="section-space bg-warm-50">
  <div class="site-container">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow">Customer experience</p>
      <h2 class="section-title mt-4">A reputation built one home at a time.</h2>
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {testimonials.map((testimonial) => (
        <figure class="premium-card rounded-card p-7 sm:p-8" data-reveal>
          <div class="font-display text-4xl leading-none text-gold-500" aria-hidden="true">“</div>
          <blockquote class="mt-5 font-display text-xl leading-8 text-navy-950">“{testimonial.quote}”</blockquote>
          <figcaption class="mt-7 border-t border-navy-900/10 pt-5">
            <strong class="block text-sm text-navy-950">{testimonial.name}</strong>
            <span class="mt-1 block text-xs font-bold uppercase tracking-[.12em] text-slate-700/60">{testimonial.location}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
