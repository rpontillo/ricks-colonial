---
import { reasons } from '../../data/home';
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const imageSrcSet = `${basePath}images/projects/colonial-08-320.webp 320w, ${basePath}images/projects/colonial-08-480.webp 480w, ${basePath}images/projects/colonial-08-640.webp 640w, ${basePath}images/projects/colonial-08-800.webp 800w, ${basePath}images/projects/colonial-08-960.webp 960w, ${basePath}images/projects/colonial-08.webp 1280w`;
---
<section class="section-space bg-white">
  <div class="site-container grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="relative" data-reveal>
      <img src="/images/projects/colonial-08.webp" srcset={imageSrcSet} sizes="(min-width: 1024px) 42vw, 100vw" alt="Rick with the company painting vans" width="1280" height="960" class="aspect-4/5 w-full rounded-[1.75rem] object-cover shadow-soft" loading="lazy" decoding="async" />
      <div class="absolute -bottom-5 right-0 max-w-60 rounded-card bg-navy-950 p-6 text-white shadow-2xl lg:-right-6">
        <strong class="font-display text-4xl text-gold-400">40+</strong>
        <p class="mt-2 text-sm font-bold leading-6 text-white/75">Years of experience serving Connecticut homeowners.</p>
      </div>
    </div>
    <div data-reveal>
      <p class="eyebrow">Why choose Rick’s</p>
      <h2 class="section-title mt-4">Experience you can see. Service you can trust.</h2>
      <p class="section-copy mt-6">Rick’s Colonial Painting LLC is built on repeat customers, referrals, and a straightforward promise: communicate clearly, prepare carefully, and complete every project with pride.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {reasons.map((reason) => <li class="check-item">{reason}</li>)}
      </ul>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a class="button-primary" href="/about">Meet the Company</a>
        <a class="button-secondary" href="/reviews">Read Reviews</a>
      </div>
    </div>
  </div>
</section>
