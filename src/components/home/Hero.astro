---
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroSrcSet = `${basePath}images/projects/colonial-03-320.webp 320w, ${basePath}images/projects/colonial-03-480.webp 480w, ${basePath}images/projects/colonial-03-640.webp 640w, ${basePath}images/projects/colonial-03-800.webp 800w, ${basePath}images/projects/colonial-03-960.webp 960w, ${basePath}images/projects/colonial-03.webp 1280w`;
---
<section class="hero relative isolate min-h-[calc(100svh-5rem)] overflow-hidden bg-navy-950 text-white">
  <img
    src="/images/projects/colonial-03.webp"
    srcset={heroSrcSet}
    sizes="100vw"
    alt="Traditional New England Colonial home painted by Rick's Colonial Painting LLC"
    width="1280"
    height="960"
    class="absolute inset-0 -z-30 size-full object-cover"
    fetchpriority="high"
  />
  <video
    class="hero-video absolute inset-0 -z-20 size-full object-cover"
    width="1280"
    height="720"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  >
    <source data-src="/videos/ricks-colonial-hero-mobile.mp4" type="video/mp4" media="(max-width: 767px)" />
    <source data-src="/videos/ricks-colonial-hero.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(20,39,61,0.94)_0%,rgba(20,39,61,0.76)_48%,rgba(20,39,61,0.24)_100%)]"></div>
  <div class="site-container flex min-h-[calc(100svh-5rem)] items-center py-20 sm:py-24">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow text-gold-400! text-over-image">Experience makes the difference</p>
      <h1 class="mt-5 text-[clamp(2.5rem,13vw,6.5rem)] leading-[0.94] text-white">Interior and exterior house painting for Farmington Valley and Greater Hartford homes.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-white/80 sm:text-xl">For over 40 years, Rick’s Colonial Painting LLC has helped homeowners throughout the Farmington Valley and Greater Hartford protect and transform the homes they love.</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a class="button-primary bg-gold-500! text-white! hover:bg-gold-400!" href="/contact">Get a Free Estimate</a>
        <a class="button-on-dark" href="/gallery">View Our Work <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-10 flex items-center gap-4 text-sm text-white/75">
        <span class="tracking-[0.18em] text-gold-400 text-over-image" aria-label="Five stars">★★★★★</span>
        <span>Family-owned. Fully licensed and insured.</span>
      </div>
    </div>
  </div>
  <a href="#services" class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs font-extrabold uppercase tracking-[0.18em] text-white/70 lg:flex">
    Explore
    <span class="grid size-9 place-items-center rounded-full border border-white/30" aria-hidden="true">↓</span>
  </a>
  <button
    type="button"
    class="hero-video-toggle absolute bottom-6 right-6 z-10 grid size-11 place-items-center rounded-full border border-white/30 bg-navy-950/45 text-white/80 backdrop-blur transition hover:bg-navy-950/70 hover:text-white focus-visible:text-white"
    aria-label="Pause background video"
    aria-pressed="false"
  >
    <span aria-hidden="true">Ⅱ</span>
  </button>
</section>

<script>
  const initializeHeroVideo = () => {
    const video = document.querySelector<HTMLVideoElement>('.hero-video');
    const toggle = document.querySelector<HTMLButtonElement>('.hero-video-toggle');
    if (!video || !toggle || toggle.dataset.initialized === 'true') return;

    toggle.dataset.initialized = 'true';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    const loadVideo = () => {
      if (reducedMotion || saveData || video.dataset.loaded === 'true') return;
      video.dataset.loaded = 'true';
      video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
        source.src = source.dataset.src ?? '';
      });
      video.load();
      void video.play().catch(() => {});
    };

    if (document.readyState === 'complete') loadVideo();
    else window.addEventListener('load', loadVideo, { once: true });

    if (reducedMotion || saveData) {
      toggle.hidden = true;
    }

    const updateToggle = () => {
      const paused = video.paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
      const icon = toggle.querySelector('span');
      if (icon) icon.textContent = paused ? '▶' : 'Ⅱ';
    };

    toggle.addEventListener('click', () => {
      if (video.paused) void video.play();
      else video.pause();
      updateToggle();
    });
    video.addEventListener('play', updateToggle);
    video.addEventListener('pause', updateToggle);
    updateToggle();
  };

  document.addEventListener('astro:page-load', initializeHeroVideo);
  initializeHeroVideo();
</script>
