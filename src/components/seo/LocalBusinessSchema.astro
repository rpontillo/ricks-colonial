---
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const homeUrl = new URL('/', Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const logoUrl = new URL('/favicon.png', Astro.site);
const imageUrl = new URL('/images/social-card.png', Astro.site);
const pageNames: Record<string, string> = {
  '/about/': 'About',
  '/contact/': 'Contact',
  '/gallery/': 'Project Gallery',
  '/reviews/': 'Customer Reviews',
  '/services/': 'Painting Services',
};
const normalizedPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    url: homeUrl,
    name: site.name,
    description: site.description,
    inLanguage: 'en-US',
    publisher: { '@id': `${homeUrl}#business` },
  },
  {
    '@type': ['HousePainter', 'LocalBusiness'],
    '@id': `${homeUrl}#business`,
    name: site.name,
    url: homeUrl,
    logo: {
      '@type': 'ImageObject',
      url: logoUrl,
      width: 512,
      height: 512,
    },
    image: imageUrl,
    telephone: site.phoneHref,
    email: site.email,
    description: site.description,
    priceRange: '$$',
    areaServed: {
      '@type': 'AdministrativeArea',
      name: site.region,
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.streetAddress,
      addressLocality: site.city,
      addressRegion: site.state,
      postalCode: site.postalCode,
      addressCountry: site.country,
    },
    founder: {
      '@type': 'Person',
      name: site.owner,
    },
    openingHoursSpecification: [{
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    }],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: site.phoneHref,
      email: site.email,
      contactType: 'customer service',
      areaServed: site.country,
      availableLanguage: 'English',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Painting and surface-care services',
      itemListElement: [
        'Interior Painting',
        'Exterior Painting',
        'Cabinet Painting',
        'Power Washing',
        'Light Commercial Painting',
      ].map((name) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name },
      })),
    },
    ...(site.socialLinks.length > 0 ? { sameAs: site.socialLinks } : {}),
  },
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    isPartOf: { '@id': `${homeUrl}#website` },
    about: { '@id': `${homeUrl}#business` },
    inLanguage: 'en-US',
    ...(normalizedPath !== '/' && pageNames[normalizedPath]
      ? { breadcrumb: { '@id': `${pageUrl}#breadcrumb` } }
      : {}),
  },
];

if (normalizedPath !== '/' && pageNames[normalizedPath]) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: pageNames[normalizedPath],
        item: pageUrl,
      },
    ],
  });
}

const schema = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
