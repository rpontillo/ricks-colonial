---
import { processSteps } from '../../data/services';
---
<ol class="mt-12 grid gap-px overflow-hidden rounded-card bg-navy-900/10 md:grid-cols-2 lg:grid-cols-4">
  {processSteps.map((step) => (
    <li class="bg-white p-7 transition-colors hover:bg-warm-50 sm:p-8">
      <span class="font-display text-4xl text-gold-500">{step.number}</span>
      <h3 class="mt-6 text-2xl">{step.title}</h3>
      <p class="mt-3 leading-7">{step.text}</p>
    </li>
  ))}
</ol>
