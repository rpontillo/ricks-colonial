---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import SectionIntro from '../components/shared/SectionIntro.astro';
import GalleryGrid from '../components/gallery/GalleryGrid.astro';
import EstimateCTA from '../components/home/EstimateCTA.astro';
import MobileCtaBar from '../components/home/MobileCtaBar.astro';
---
<MainLayout title="Painting Project Gallery | Rick's Colonial Painting" description="Browse interior, exterior, cabinet, and deck painting inspiration from Rick's Colonial Painting in Central Connecticut.">
  <PageHero eyebrow="Project gallery" title="Transformation lives in the details." intro="Explore a selection of interior, exterior, cabinet, and outdoor-space inspiration. Final photography will be replaced with Rick’s approved project portfolio before launch." image="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=88" />
  <section class="section-space">
    <div class="site-container">
      <SectionIntro eyebrow="Selected work" title="Spaces renewed with preparation and care." text="Use the filters to explore different project types. Select any image for a larger view." />
      <div class="mt-12"><GalleryGrid /></div>
    </div>
  </section>
  <section class="pb-20 sm:pb-28">
    <div class="site-container"><div class="rounded-card bg-sand-100 p-7 sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-12"><div><p class="eyebrow">Photography note</p><h2 class="mt-3 text-3xl sm:text-4xl">Your real projects will make this page exceptional.</h2><p class="mt-4 max-w-2xl leading-7">The gallery currently uses licensed placeholder photography for layout development. Before launch, replace it with original before-and-after images, detail shots, and completed rooms or exteriors.</p></div><a href="/contact" class="button-primary mt-7 shrink-0 lg:mt-0">Start a project</a></div></div>
  </section>
  <EstimateCTA /><MobileCtaBar />
</MainLayout>
