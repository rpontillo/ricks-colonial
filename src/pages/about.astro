---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import SectionIntro from '../components/shared/SectionIntro.astro';
import EstimateCTA from '../components/home/EstimateCTA.astro';
import MobileCtaBar from '../components/home/MobileCtaBar.astro';
const values = [
  ['Craftsmanship', 'The finished surface matters, but so does every repair, edge, and preparation step underneath it.'],
  ['Accountability', 'Owner-supervised work and direct communication keep decisions clear and expectations aligned.'],
  ['Respect', 'Homes, furnishings, landscaping, schedules, and neighbors are treated with care throughout the project.'],
  ['Longevity', 'Materials and methods are selected to create a finish that looks good and performs over time.'],
];
---
<MainLayout title="About Rick's Colonial Painting LLC" description="Learn about Rick's Colonial Painting LLC, a family-owned Connecticut painting company focused on preparation, craftsmanship, and owner-supervised service.">
  <PageHero eyebrow="About us" title="Experience you can see in the details." intro="For more than four decades, Rick’s Colonial Painting LLC has helped Connecticut homeowners protect and transform the places they call home." image="/images/projects/colonial-05.jpg" />
  <section class="section-space">
    <div class="site-container grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-20">
      <div>
        <img src="/images/projects/colonial-08.jpg" alt="Rick with the company painting vans" class="aspect-4/5 w-full rounded-card object-cover shadow-soft" />
      </div>
      <div>
        <SectionIntro eyebrow="Our story" title="A local painting company built on trust." />
        <div class="mt-7 space-y-5 leading-8">
          <p>Rick’s Colonial Painting LLC is a family-owned company serving the Farmington Valley, Greater Hartford, and surrounding Central Connecticut communities. The business has grown through repeat customers, referrals, and a simple belief: careful preparation and honest service create the best long-term results.</p>
          <p>Projects are owner supervised, communication stays direct, and each home is approached as a place that deserves protection—not just another job site. That means explaining the process, setting realistic expectations, keeping work areas organized, and giving details the time they require.</p>
          <p>The visual style of a home may change over the years. The standards behind the work should not.</p>
        </div>
        <a class="button-primary mt-8" href="/contact">Meet us at your project</a>
      </div>
    </div>
  </section>
  <section class="section-space bg-navy-950 text-white">
    <div class="site-container">
      <SectionIntro eyebrow="What guides the work" title="Traditional values, modern materials." text="Experience matters most when it improves the customer’s experience and the durability of the finished result." inverse />
      <div class="mt-12 grid gap-px overflow-hidden rounded-card bg-white/12 sm:grid-cols-2 lg:grid-cols-4">
        {values.map(([title, text]) => <article class="bg-navy-950 p-7 sm:p-8"><h3 class="text-2xl text-white">{title}</h3><p class="mt-4 leading-7 text-white/68">{text}</p></article>)}
      </div>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container grid gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionIntro eyebrow="The Rick’s difference" title="Owner supervision from estimate through completion." text="A consistent point of accountability helps prevent the communication gaps common in contractor projects. Questions are answered by someone who understands the estimate, the plan, and the work happening on site." />
      <div class="grid gap-5 sm:grid-cols-2">
        {['Clear written scope', 'Careful property protection', 'Professional preparation', 'Clean final walkthrough'].map((item) => <div class="rounded-card border border-navy-900/10 bg-white p-6 shadow-soft"><h3 class="text-xl">{item}</h3></div>)}
      </div>
    </div>
  </section>
  <EstimateCTA /><MobileCtaBar />
</MainLayout>
