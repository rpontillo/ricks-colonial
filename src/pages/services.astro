---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import SectionIntro from '../components/shared/SectionIntro.astro';
import ProcessSteps from '../components/services/ProcessSteps.astro';
import FaqList from '../components/shared/FaqList.astro';
import EstimateCTA from '../components/home/EstimateCTA.astro';
import MobileCtaBar from '../components/home/MobileCtaBar.astro';
import { additionalServices, serviceDetails, serviceFaqs } from '../data/services';
const imageSrcSet = (src: string) =>
  `${src.replace('.webp', '-640.webp')} 640w, ${src.replace('.webp', '-960.webp')} 960w, ${src} 1280w`;
---
<MainLayout title="Connecticut Painting Services | Rick's Colonial Painting LLC" description="Interior painting, exterior painting, deck restoration, cabinet painting, power washing, and light commercial painting in Central Connecticut.">
  <PageHero eyebrow="Painting services" title="Careful work. Lasting finishes." intro="Every project is built around the same fundamentals: clear communication, thorough preparation, quality materials, and respect for the property." image="/images/projects/colonial-06.webp" />
  <section class="section-space">
    <div class="site-container">
      <SectionIntro eyebrow="What we do" title="Complete painting and surface-care services." text="Explore the core services below. Project scope and preparation are tailored to the surface, condition, and finish you want—not forced into a one-size-fits-all package." />
      <div class="mt-16 space-y-20 lg:space-y-28">
        {serviceDetails.map((service, index) => (
          <article id={service.id} class="scroll-mt-28 grid items-center gap-10 lg:grid-cols-2 lg:gap-16" data-reveal>
            <div class:list={['overflow-hidden rounded-card shadow-soft', index % 2 === 1 && 'lg:order-2']}>
              <img src={service.image} srcset={imageSrcSet(service.image)} sizes="(min-width: 1024px) 50vw, 100vw" alt={`${service.title} project by Rick's Colonial Painting LLC`} width="1280" height="960" class="aspect-4/3 size-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div>
              <h2 class="text-4xl sm:text-5xl">{service.title}</h2>
              <p class="mt-5 text-xl font-semibold leading-8 text-navy-900">{service.summary}</p>
              <p class="mt-5 leading-8">{service.description}</p>
              <ul class="mt-7 grid gap-3 sm:grid-cols-2">{service.features.map((feature) => <li class="check-item">{feature}</li>)}</ul>
              <a class="button-primary mt-8" href="/contact">Request an estimate</a>
            </div>
          </article>
        ))}
      </div>
      <aside class="mt-20 rounded-card border border-navy-900/10 bg-sand-100 p-7 sm:p-10 lg:mt-28" data-reveal>
        <p class="eyebrow">Additional capabilities</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Preparation and repair work that supports a lasting finish.</h2>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {additionalServices.map((service) => <li class="check-item font-bold text-navy-900">{service}</li>)}
        </ul>
      </aside>
    </div>
  </section>
  <section class="section-space bg-sand-100">
    <div class="site-container"><SectionIntro eyebrow="Our process" title="A clear path from walkthrough to final coat." /><ProcessSteps /></div>
  </section>
  <section class="section-space">
    <div class="site-container max-w-5xl"><SectionIntro eyebrow="Common questions" title="What homeowners ask before getting started." /><FaqList items={serviceFaqs} /></div>
  </section>
  <EstimateCTA /><MobileCtaBar />
</MainLayout>
