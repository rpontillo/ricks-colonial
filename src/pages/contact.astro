---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import EstimateForm from '../components/contact/EstimateForm.astro';
import MobileCtaBar from '../components/home/MobileCtaBar.astro';
import { site } from '../data/site';
---
<MainLayout title="Free Painting Estimate | Rick's Colonial Painting" description="Request a free interior or exterior painting estimate from Rick's Colonial Painting in Central Connecticut.">
  <PageHero eyebrow="Free estimate" title="Tell us about your project." intro="Share a few details below. We’ll follow up to discuss the space, priorities, timing, and the best next step for an accurate estimate." image="https://images.unsplash.com/photo-1562259949-e8e7689d7828?auto=format&fit=crop&w=2000&q=88" />
  <section class="section-space">
    <div class="site-container grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-16">
      <aside>
        <p class="eyebrow">Contact Rick’s</p>
        <h2 class="mt-4 text-4xl sm:text-5xl">A straightforward start.</h2>
        <p class="mt-6 leading-8">Call, email, or use the form. Photos are helpful for initial context, but most projects require an on-site walkthrough before a firm estimate.</p>
        <div class="mt-9 space-y-4">
          <a href={`tel:${site.phoneHref}`} class="contact-card"><span>Call</span><strong>{site.phoneDisplay}</strong></a>
          <a href={`mailto:${site.email}`} class="contact-card"><span>Email</span><strong>{site.email}</strong></a>
          <div class="contact-card"><span>Service area</span><strong>{site.region}</strong></div>
          <div class="contact-card"><span>Typical hours</span><strong>{site.hours}</strong></div>
        </div>
        <div class="mt-9 rounded-card bg-sand-100 p-6"><h3 class="text-xl">Helpful estimate details</h3><ul class="mt-4 space-y-3"><li class="check-item">Project address or town</li><li class="check-item">Rooms or exterior surfaces</li><li class="check-item">Known repairs or damage</li><li class="check-item">Preferred timing</li></ul></div>
      </aside>
      <div><EstimateForm /></div>
    </div>
  </section>
  <MobileCtaBar />
</MainLayout>
