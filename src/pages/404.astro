---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Page Not Found | Rick's Colonial Painting" description="The requested page could not be found." noindex>
  <section class="section-space bg-warm-50">
    <div class="site-container max-w-3xl text-center">
      <p class="eyebrow">404 error</p>
      <h1 class="section-title mt-4">This page needs a fresh coat.</h1>
      <p class="section-copy mx-auto mt-6">The page may have moved or no longer exists. Return home or explore our painting services.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4"><a class="button-primary" href="/">Return Home</a><a class="button-secondary" href="/services">View Services</a></div>
    </div>
  </section>
</MainLayout>
